  "exit_rules": {
    "profitTarget": 0.5,
    "stopLoss": 0.75,
    "dteExit": 14
  },
  
  "risk_params": {
    "accountBalance": 100000,
    "riskPercent": 5,
    "maxPositions": 1
  },
  
  "description": "Conservative RSI divergence strategy for BTC. Enters on high-confidence divergences (>70%) with 20-60 DTE spreads. Exits at 50% profit or 75% loss."
