{
  "name": "RSI Divergence - BTC Conservative",
  "strategy": "rsi_divergence",
  "symbol": "BTC-USDT",
  "enabled": true,
  
  "entry_rules": {
    "timeframe": "1h",
    "lookback": 20,
    "rsiOverbought": 70,
    "rsiOversold": 30,
